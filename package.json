{
  "name": "waoowaoo",
  "version": "0.4.1",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prepare": "husky",
    "dev": "cross-env WAO_DEV_ENV_FILE=.env node scripts/dev-docker.mjs",
    "dev:infra": "docker compose up -d mysql redis minio temporal-create-namespace",
    "dev:cloud": "npm run env:cloud:check:dev && npm run runtime:sms:smoke && cross-env WAO_DEV_ENV_FILE=.env.cloud.local node scripts/dev-docker.mjs",
    "dev:local": "npm run dev:infra && npm run storage:init && cross-env CODEX_RUNTIME_DRIVER=local concurrently --kill-others \"npm run dev:next\" \"npm run dev:temporal-worker\"",
    "dev:next": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbopack -H 0.0.0.0",
    "dev:next:cloud": "node scripts/run-with-env.mjs .env.cloud.local -- node_modules/next/dist/bin/next dev --turbopack -H 0.0.0.0",
    "dev:temporal-worker": "cross-env TEMPORAL_WORKER_BUILD_ID=local TEMPORAL_WORKER_VERSIONING_ENABLED=false tsx watch --env-file=.env src/lib/temporal/worker.ts",
    "dev:temporal-worker:cloud": "node scripts/run-with-env.mjs .env.cloud.local -- tsx watch src/lib/temporal/worker.ts",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0",
    "build": "prisma generate && next build --turbopack && node scripts/check-next-build-artifacts.mjs && npm run runtime:sms:smoke",
    "build:verify": "cross-env NEXT_DIST_DIR=.next-verify npm run build",
    "build:verify:cloud": "npm run env:cloud:check:dev && cross-env NEXT_DIST_DIR=.next-verify node scripts/run-with-env.mjs .env.cloud.local -- npm run build",
    "start": "npm run storage:init && concurrently --kill-others \"npm run start:next\" \"npm run start:temporal-worker\"",
    "storage:init": "tsx --env-file=.env src/lib/storage/init.ts",
    "storage:init:cloud": "node scripts/run-with-env.mjs .env.cloud.local -- tsx src/lib/storage/init.ts",
    "env:cloud:check": "node scripts/check-cloud-env.mjs .env.cloud.local --mode=production",
    "env:cloud:check:dev": "node scripts/check-cloud-env.mjs .env.cloud.local --mode=development",
    "start:next": "next start -H 0.0.0.0",
    "start:temporal-worker": "tsx --env-file=.env src/lib/temporal/worker.ts",
    "temporal:worker:rollout": "sh scripts/temporal/worker-rollout.sh",
    "db:push": "prisma db push --skip-generate",
    "stats:errors": "tsx scripts/task-error-stats.ts",
    "architecture:impact": "node scripts/architecture-impact.mjs",
    "architecture:durable-budget": "node scripts/check-durable-kernel-budget.mjs",
    "architecture:failure-governance": "tsx --tsconfig tsconfig.runtime-scripts.json scripts/check-failure-governance.ts",
    "runtime:codex:smoke": "tsx scripts/codex-runtime-smoke.ts",
    "runtime:codex:container-smoke": "tsx scripts/codex-runtime-container-smoke.ts",
    "runtime:codex:gateway-error-smoke": "tsx scripts/codex-gateway-error-smoke.ts",
    "runtime:sms:smoke": "tsx --tsconfig tsconfig.runtime-scripts.json scripts/aliyun-sms-sdk-smoke.ts",
    "check:media-normalization": "tsx scripts/check-media-normalization.ts",
    "check:capability-catalog": "node scripts/check-capability-catalog.mjs",
    "check:pricing-catalog": "tsx --tsconfig tsconfig.runtime-scripts.json scripts/check-pricing-catalog.ts",
    "check:model-config-contract": "node scripts/check-model-config-contract.mjs --strict",
    "check:outbound-image-runtime-sample": "tsx scripts/check-outbound-image-runtime-sample.ts",
    "check:outbound-image-success-rate": "tsx scripts/check-outbound-image-success-rate.ts",
    "check:image-urls-contract": "tsx scripts/check-image-urls-contract.ts",
    "billing:cleanup-pending-freezes": "tsx scripts/billing-cleanup-pending-freezes.ts",
    "billing:reconcile-ledger": "tsx scripts/billing-reconcile-ledger.ts",
    "test:security": "cross-env BILLING_TEST_BOOTSTRAP=0 playwright test --config tests/browser-security/playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime-scripts.json",
    "lint:all": "npm run lint -- .",
    "security:secrets:staged": "node scripts/security/secret-scan.mjs --staged",
    "security:secrets:repo": "node scripts/security/secret-scan.mjs --repo",
    "verify:commit": "echo \"verify:commit skipped; Git hooks only scan secrets and test scheduling is intentionally deferred.\"",
    "test:services:prepare": "tsx scripts/test-services.ts prepare",
    "test:services:start": "tsx scripts/test-services.ts start",
    "test:services:stop": "tsx scripts/test-services.ts stop",
    "verify:push": "bash scripts/verify-push.sh",
    "migrate:workspace-text-previews": "tsx --env-file=.env scripts/backfill-workspace-text-previews.ts",
    "migrate:image-urls-contract": "tsx scripts/migrate-image-urls-contract.ts",
    "migrate:graph-artifacts-unique-index": "tsx scripts/migrations/migrate-graph-artifacts-unique-index.ts",
    "backup:media-safety": "tsx scripts/media-safety-backup.ts",
    "backup:media-restore-dry-run": "tsx scripts/media-restore-dry-run.ts",
    "media:backfill-refs": "tsx scripts/media-backfill-refs.ts",
    "backup:archive-legacy-media": "tsx scripts/media-archive-legacy-refs.ts",
    "backup:unreferenced-media-index": "tsx scripts/media-build-unreferenced-index.ts",
    "lint": "eslint",
    "clean": "rimraf .next .next-verify",
    "test:logic": "cross-env BILLING_TEST_BOOTSTRAP=0 node scripts/test-verification/run-required-suite.mjs --suite logic --root tests/unit",
    "test:conformance": "cross-env BILLING_TEST_BOOTSTRAP=0 node scripts/test-verification/run-required-suite.mjs --suite conformance --root tests/contracts",
    "test:critical:provider": "cross-env BILLING_TEST_BOOTSTRAP=0 node scripts/test-verification/run-required-suite.mjs --suite critical-provider --root tests/integration/provider",
    "test:critical:task": "cross-env BILLING_TEST_BOOTSTRAP=1 node scripts/test-verification/run-required-suite.mjs --suite critical-task --root tests/integration/task",
    "test:critical:temporal": "cross-env BILLING_TEST_BOOTSTRAP=1 TEMPORAL_TEST_BOOTSTRAP=1 node scripts/test-verification/run-required-suite.mjs --suite critical-temporal --root tests/integration/temporal",
    "test:critical:billing": "cross-env BILLING_TEST_BOOTSTRAP=1 node scripts/test-verification/run-required-suite.mjs --suite critical-billing --root tests/integration/billing",
    "test:critical:billing-concurrency": "cross-env BILLING_TEST_BOOTSTRAP=1 node scripts/test-verification/run-required-suite.mjs --suite critical-billing-concurrency --root tests/concurrency/billing",
    "test:critical:security": "cross-env BILLING_TEST_BOOTSTRAP=1 node scripts/test-verification/run-required-suite.mjs --suite critical-security --root tests/integration/security",
    "test:critical": "npm run test:critical:provider && npm run test:critical:task && npm run test:critical:temporal && npm run test:critical:billing && npm run test:critical:billing-concurrency && npm run test:critical:security"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.22",
    "@ai-sdk/openai": "^3.0.26",
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@ai-sdk/react": "^3.0.118",
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@assistant-ui/react": "^0.12.24",
    "@assistant-ui/react-ai-sdk": "^1.3.18",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/genai": "^1.34.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@openrouter/sdk": "^0.13.65",
    "@prisma/client": "^6.19.3",
    "@stripe/stripe-js": "^9.12.1",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-virtual": "^3.13.24",
    "@temporalio/activity": "1.21.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/common": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.2",
    "ffmpeg-ffprobe-static": "^6.1.2-rc.1",
    "geist": "^1.7.0",
    "ioredis": "^5.9.2",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.9",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "next": "^15.5.20",
    "next-auth": "^4.24.11",
    "next-intl": "^4.7.0",
    "openai": "^6.46.0",
    "prisma": "^6.19.3",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "husky": "^9.1.7",
    "mysql2": "^3.15.1",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.19",
    "next-auth": {
      "uuid": "11.1.1"
    }
  }
}
