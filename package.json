  "scripts": {
    "postinstall": "prisma generate",
    "prepare": "husky",
    "dev": "npm run storage:init && concurrently --kill-others \"npm run dev:next\" \"npm run dev:worker\" \"npm run dev:log-cleanup\" \"npm run dev:board\"",
    "dev:cloud": "npm run env:cloud:check && npm run storage:init:cloud && concurrently --kill-others \"npm run dev:next:cloud\" \"npm run dev:worker:cloud\" \"npm run dev:log-cleanup:cloud\" \"npm run dev:board:cloud\"",
    "dev:next": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbopack -H 0.0.0.0",
    "dev:next:cloud": "node scripts/run-with-env.mjs .env .env.cloud.local -- node_modules/next/dist/bin/next dev --turbopack -H 0.0.0.0",
    "dev:worker": "tsx watch --env-file=.env src/lib/workers/index.ts",
    "dev:worker:cloud": "node scripts/run-with-env.mjs .env .env.cloud.local -- tsx watch src/lib/workers/index.ts",
    "dev:log-cleanup": "tsx watch --env-file=.env scripts/log-cleanup.ts",
    "dev:log-cleanup:cloud": "node scripts/run-with-env.mjs .env .env.cloud.local -- tsx watch scripts/log-cleanup.ts",
    "dev:board": "tsx watch --env-file=.env scripts/bull-board.ts",
    "dev:board:cloud": "node scripts/run-with-env.mjs .env .env.cloud.local -- tsx watch scripts/bull-board.ts",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0",
    "build": "prisma generate && next build",
    "build:verify": "cross-env NEXT_DIST_DIR=.next-verify npm run build:turbo",
    "build:verify:cloud": "npm run env:cloud:check && cross-env NEXT_DIST_DIR=.next-verify node scripts/run-with-env.mjs .env .env.cloud.local -- npm run build:turbo",
    "build:turbo": "prisma generate && next build --turbopack",
    "start": "npm run storage:init && concurrently --kill-others \"npm run start:next\" \"npm run start:worker\" \"npm run start:log-cleanup\" \"npm run start:board\"",
    "storage:init": "tsx --env-file=.env src/lib/storage/init.ts",
    "storage:init:cloud": "node scripts/run-with-env.mjs .env .env.cloud.local -- tsx src/lib/storage/init.ts",
    "env:cloud:check": "node scripts/check-cloud-env.mjs .env.cloud.local",
    "start:next": "next start -H 0.0.0.0",
    "start:worker": "tsx --env-file=.env src/lib/workers/index.ts",
