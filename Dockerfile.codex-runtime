FROM node:22-bookworm-slim

ARG CODEX_CLI_VERSION=0.146.0

# Codex 0.146 uses bubblewrap for its Linux sandbox. The outer runtime
# container grants only the bounded capabilities needed by this setuid
# helper; app-server itself still runs as the unprivileged node user.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      bubblewrap \
      ca-certificates \
      ffmpeg \
      jq \
      python3 \
      ripgrep \
      tini \
    && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 4755 /usr/bin/bwrap \
    && mkdir -p /workspace /runtime/codex-home \
    && chown -R node:node /workspace /runtime

COPY --chown=root:root docker/codex-runtime/entrypoint.sh /usr/local/bin/wao-codex-runtime
RUN chmod 0755 /usr/local/bin/wao-codex-runtime

ENV CODEX_HOME=/runtime/codex-home
ENV HOME=/runtime/codex-home

# Match the production Web container's unprivileged node user so bind-mounted
# materializations remain writable without world-writable permissions.
USER 1000:1000
WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/wao-codex-runtime"]
