generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model CharacterAppearance {
  id                   String                  @id @default(uuid())
  characterId          String
  appearanceIndex      Int
  changeReason         String
  description          String?                 @db.Text
  descriptions         String?                 @db.Text
  imageUrl             String?                 @db.Text
  imageUrls            String?                 @db.Text
  selectedIndex        Int?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @default(now()) @updatedAt
  previousImageUrl     String?                 @db.Text
  previousImageUrls    String?                 @db.Text
  previousDescription  String?                 @db.Text // 上一次的描述词（用于撤回）
  previousDescriptions String?                 @db.Text // 上一次的描述词数组（用于撤回）
  imageMediaId         String?
  imageMedia           MediaObject?            @relation("CharacterAppearanceImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  character            ProjectCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, appearanceIndex])
  @@index([characterId])
  @@index([imageMediaId])
  @@map("character_appearances")
}

model LocationImage {
  id                  String                   @id @default(uuid())
  locationId          String
  imageIndex          Int
  description         String?                  @db.Text
  imageUrl            String?                  @db.Text
  spatialProfileJson  Json?
  spatialProfileStatus String                  @default("pending")
  spatialProfileError String?                  @db.LongText
  spatialProfileAnalyzedAt DateTime?
  spatialProfileModel String?
  isSelected          Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @default(now()) @updatedAt
  previousImageUrl    String?                  @db.Text
  previousDescription String?                  @db.Text // 上一次的描述词（用于撤回）
  imageMediaId        String?
  imageMedia          MediaObject?             @relation("LocationImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  location            ProjectLocation   @relation("LocationImages", fields: [locationId], references: [id], onDelete: Cascade)
  selectedByLocations ProjectLocation[] @relation("SelectedLocationImage")

  @@unique([locationId, imageIndex])
  @@index([locationId])
  @@index([imageMediaId])
  @@map("location_images")
}

model ProjectCharacter {
  id                      String                @id @default(uuid())
  projectId               String
  name                    String
  aliases                 String?               @db.Text
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  profileData             String?               @db.Text
  profileConfirmed        Boolean               @default(false)
  introduction            String?               @db.Text // 角色介绍（身份、关系、称呼映射，如"我"对应此角色）
  sourceGlobalCharacterId String? // 🆕 来源全局角色ID（复制时记录）
  appearances             CharacterAppearance[]
  project                 Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_characters")
}

model ProjectLocation {
  id                      String                @id @default(uuid())
  projectId               String
  name                    String
  summary                 String?               @db.Text // 场景简要描述（用途/人物关联）
  assetKind               String                @default("location")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  sourceGlobalLocationId  String? // 🆕 来源全局场景ID（复制时记录）
  selectedImageId         String?
  selectedImage           LocationImage?        @relation("SelectedLocationImage", fields: [selectedImageId], references: [id], onDelete: SetNull)
  images                  LocationImage[]       @relation("LocationImages")
  project                 Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, assetKind, name])
  @@index([projectId])
  @@map("project_locations")
}

model ProjectEpisode {
  id                      String                     @id @default(uuid())
  projectId               String
  episodeNumber           Int
  name                    String
  description             String?                    @db.Text
  novelText               String?                    @db.Text
  audioUrl                String?                    @db.Text
  audioMediaId            String?
  audioMedia              MediaObject?               @relation("ProjectEpisodeAudioMedia", fields: [audioMediaId], references: [id], onDelete: SetNull)
  srtContent              String?                    @db.Text
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @default(now()) @updatedAt
  project                 Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyboards             ProjectStoryboard[]
  chapters                ProjectEditChapter[]
  sourceDocuments         ProjectEpisodeSourceDocument[]
  editBible               ProjectEditBible?
  musicScore              ProjectEditMusicScore?
  soundscape              ProjectEditSoundscape?
  finalOutput             ProjectEpisodeFinalOutput?
  canvasLayout            ProjectCanvasLayout?
  editStylePreviews       ProjectEditStylePreview[]
  editScripts             ProjectEditScript[]
  editShotExecutionPlans  ProjectEditShotExecutionPlan[]
  editAssetRequirements   ProjectEditAssetRequirement[]
  videoGroups             ProjectVideoGroup[]

  @@unique([projectId, episodeNumber])
  @@index([projectId])
  @@index([audioMediaId])
  @@map("project_episodes")
}

model ProjectEditChapter {
  id                String         @id @default(uuid())
  episodeId         String
  chapterIndex      Int
  title             String?
  summary           String?        @db.Text
  sourceDocumentId  String?
  sourceStart       Int?
  sourceEnd         Int?
  targetDurationSec Int?
  entrySnapshotJson Json?
  eventsJson        Json?
  planVersion       Int            @default(1)
  provenanceJson    Json?
  status            String         @default("ready")
  renderStatus      String?
  renderTaskId      String?
  outputMediaId     String?
  outputMedia       MediaObject?   @relation("ProjectEditChapterOutputMedia", fields: [outputMediaId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  episode           ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sourceDocument    ProjectEpisodeSourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  editScript        ProjectEditScript?
  shotExecutionPlan ProjectEditShotExecutionPlan?
  storyboards       ProjectStoryboard[]
  requirements      ProjectEditAssetRequirement[]
  videoGroups       ProjectVideoGroup[]

  @@unique([episodeId, chapterIndex])
  @@index([episodeId])
  @@index([sourceDocumentId])
  @@index([outputMediaId])
  @@map("project_edit_chapters")
}

model ProjectEpisodeSourceDocument {
  id             String         @id @default(uuid())
  episodeId      String
  normalizedText String         @db.LongText
  checksum       String         @db.VarChar(64)
  sourceKind     String         @db.VarChar(64)
  scriptStructureJson Json?
  rawFileMediaId String?
  version        Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  episode        ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  rawFileMedia   MediaObject?   @relation("ProjectEpisodeSourceDocumentRawFileMedia", fields: [rawFileMediaId], references: [id], onDelete: SetNull)
  editBibles     ProjectEditBible[]
  chapters       ProjectEditChapter[]

  @@unique([episodeId, version])
  @@index([episodeId])
  @@index([rawFileMediaId])
  @@map("project_episode_source_documents")
}

model ProjectEditBible {
  id                 String         @id @default(uuid())
  episodeId          String         @unique
  sourceDocumentId   String
  bibleJson          Json?
  beatSheetJson      Json?
  ledgerJson         Json?
  emotionalCurveJson Json?
  styleBibleJson     Json?
  diagnosticsJson    Json?
  version            Int            @default(1)
  status             String         @default("pending")
  lockedAt           DateTime?
  generationTaskId   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  episode            ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sourceDocument     ProjectEpisodeSourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  stylePreviews      ProjectEditStylePreview[]

  @@index([episodeId])
  @@index([sourceDocumentId])
  @@index([generationTaskId])
  @@map("project_edit_bibles")
}

model ProjectEditStylePreview {
  id               String                @id @default(uuid())
  projectId        String
  episodeId        String
  editBibleId      String
  styleKey         String
  aspectRatio      String
  title            String
  summary          String                @db.LongText
  styleBibleJson   Json
  imagePrompt      String                @db.LongText
  imageKey         String?
  status           String                @default("pending")
  taskId           String?
  errorMessage     String?               @db.LongText
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode          ProjectEpisode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  editBible        ProjectEditBible      @relation(fields: [editBibleId], references: [id], onDelete: Cascade)

  @@unique([editBibleId, styleKey])
  @@index([projectId])
  @@index([episodeId])
  @@index([editBibleId])
  @@index([taskId])
  @@map("project_edit_style_previews")
}

model ProjectEditScript {
  id             String                         @id @default(uuid())
  projectId      String
  episodeId      String
  chapterId      String                         @unique
  corePlanJson  Json?
  durationSec    Int
  shotCount      Int
  status         String                         @default("ready")
  assetReviewStatus String                      @default("pending")
  generationTaskId  String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @default(now()) @updatedAt
  project        Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode        ProjectEpisode                 @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  chapter        ProjectEditChapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  shotExecutionPlan ProjectEditShotExecutionPlan?
  requirements   ProjectEditAssetRequirement[]
  storyboard      ProjectStoryboard?

  @@index([projectId])
  @@index([episodeId])
  @@index([chapterId])
  @@index([generationTaskId])
  @@map("project_edit_scripts")
}

model ProjectEditShotExecutionPlan {
  id            String            @id @default(uuid())
  projectId     String
  episodeId     String
  chapterId     String            @unique
  editScriptId  String            @unique
  executionPlanJson Json
  status        String            @default("ready")
  generationTaskId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode       ProjectEpisode    @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  chapter       ProjectEditChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  editScript    ProjectEditScript @relation(fields: [editScriptId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([episodeId])
  @@index([chapterId])
  @@index([editScriptId])
  @@index([generationTaskId])
  @@map("project_edit_shot_execution_plans")
}

model ProjectEditAssetRequirement {
  id           String            @id @default(uuid())
  editScriptId String
  projectId    String
  episodeId    String
  chapterId    String
  kind         String
  name         String
  description  String            @db.LongText
  requiredForShotIds Json
  status       String            @default("pending")
  targetId     String?
  errorMessage String?           @db.LongText
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  editScript   ProjectEditScript @relation(fields: [editScriptId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode      ProjectEpisode    @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  chapter      ProjectEditChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([editScriptId, kind, name])
  @@index([projectId])
  @@index([episodeId])
  @@index([chapterId])
  @@index([targetId])
  @@map("project_edit_asset_requirements")
}

model ProjectEpisodeFinalOutput {
  id            String         @id @default(uuid())
  episodeId     String         @unique
  renderStatus  String?
  renderTaskId  String?
  outputUrl     String?        @db.Text
  outputMediaId String?
  outputMedia   MediaObject?   @relation("ProjectEpisodeFinalOutputMedia", fields: [outputMediaId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  episode       ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([outputMediaId])
  @@map("project_episode_final_outputs")
}

model ProjectEditMusicScore {
  id                String         @id @default(uuid())
  episodeId         String         @unique
  cuesJson          Json?
  mixJson           Json?
  diagnosticsJson   Json?
  version           Int            @default(1)
  status            String         @default("pending")
  taskId            String?
  timelineSignature String?
  musicModel        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  episode           ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([taskId])
  @@map("project_edit_music_scores")
}

model ProjectEditSoundscape {
  id                String         @id @default(uuid())
  episodeId         String         @unique
  planJson          Json?
  sourcesJson       Json?
  mixJson           Json?
  diagnosticsJson   Json?
  version           Int            @default(1)
  status            String         @default("pending")
  taskId            String?
  timelineSignature String?
  soundEffectModel  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  episode           ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([taskId])
  @@map("project_edit_soundscapes")
}

model ProjectVideoGroup {
  id                    String          @id @default(uuid())
  projectId             String
  episodeId             String
  chapterId             String
  gridMode              String
  shotIds               Json
  shotNumbers           Json
  durationSec           Int
  prompt                String?         @db.LongText
  status                String          @default("pending")
  taskId                String?
  errorCode             String?
  errorMessage          String?         @db.LongText
  referenceImageUrl     String?         @db.Text
  referenceImageMediaId String?
  referenceImageMedia   MediaObject?    @relation("ProjectVideoGroupReferenceImageMedia", fields: [referenceImageMediaId], references: [id], onDelete: SetNull)
  videoUrl              String?         @db.Text
  videoMediaId          String?
  videoMedia            MediaObject?    @relation("ProjectVideoGroupVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt
  project               Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode               ProjectEpisode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  chapter               ProjectEditChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([episodeId])
  @@index([chapterId])
  @@index([referenceImageMediaId])
  @@index([videoMediaId])
  @@index([taskId])
  @@map("project_video_groups")
}

model ProjectPanel {
  id                   String                    @id @default(uuid())
  storyboardId         String
  panelIndex           Int
  panelNumber          Int?
  shotType             String?                   @db.Text
  cameraMove           String?                   @db.Text
  description          String?                   @db.Text
  location             String?                   @db.Text
  characters           String?                   @db.Text
  props                String?                   @db.Text
  srtSegment           String?                   @db.Text
  srtStart             Float?
  srtEnd               Float?
  duration             Float?
  imagePrompt          String?                   @db.Text
  imageUrl             String?                   @db.Text
  imageMediaId         String?
  imageMedia           MediaObject?              @relation("ProjectPanelImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  videoPrompt          String?                   @db.Text
  videoUrl             String?                   @db.Text
  lastVideoGenerationOptions Json?
  videoMediaId         String?
  videoMedia           MediaObject?              @relation("ProjectPanelVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @default(now()) @updatedAt
  sceneType            String?
  candidateImages      String?                   @db.Text
  sourceShotId         String?
  sourceGenerationSegmentId String?              @db.Text
  executionSnapshotJson Json?
  renderFactsJson      Json?
  actingNotes          String?                   @db.Text // 演技指导数据 JSON
  storyboard           ProjectStoryboard  @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  @@unique([storyboardId, panelIndex])
  @@index([storyboardId])
  @@index([imageMediaId])
  @@index([videoMediaId])
  @@index([sourceShotId])
  @@map("project_panels")
}

model MutationBatch {
  id          String         @id @default(uuid())
  projectId   String
  userId      String
  source      String
  operationId String?
  summary     String?        @db.Text
  status      String         @default("active") // active | reverted | failed
  revertError String?        @db.Text
  revertedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  entries     MutationEntry[]
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("mutation_batches")
}

model MutationEntry {
  id         String        @id @default(uuid())
  batchId    String
  kind       String
  targetType String
  targetId   String
  payload    Json?
  createdAt  DateTime      @default(now())
  batch      MutationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([targetType, targetId])
  @@map("mutation_entries")
}

model ProjectAssistantThread {
  id           String   @id @default(uuid())
  projectId    String
  userId       String
  episodeId    String?
  assistantId  String
  scopeRef     String
  messagesJson Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, assistantId, scopeRef])
  @@index([projectId, episodeId, updatedAt])
  @@index([userId, updatedAt])
  @@map("project_assistant_threads")
}

model ProjectAgentWait {
  id              String    @id @default(uuid())
  runId           String?
  activityId      String?
  projectId       String
  userId          String
  assistantId     String    @db.VarChar(64)
  scopeRef        String    @db.VarChar(64)
  episodeId       String?
  operationId     String    @db.VarChar(128)
  taskIds         Json
  followUpMode    String    @default("resume_agent") @db.VarChar(32)
  status          String    @default("pending") @db.VarChar(32)
  runVersion      Int       @default(0)
  eventSeq        BigInt    @default(0)
  terminalStatus  String?   @db.VarChar(32)
  terminalTaskIds Json?
  failedTaskIds   Json?
  canceledTaskIds Json?
  followUpKey     String?   @db.VarChar(96)
  followUpCommandId String? @db.VarChar(191)
  claimId         String?   @db.VarChar(36)
  claimedAt       DateTime?
  claimExpiresAt  DateTime?
  followedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
  run             ProjectAgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  activity        ProjectAgentActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  continuationCheckpoint ProjectAgentContinuationCheckpoint?
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([activityId])
  @@index([projectId, userId, assistantId, scopeRef, status, createdAt])
  @@index([projectId, status, createdAt])
  @@index([followUpKey])
  @@index([followUpCommandId])
  @@index([claimId])
  @@map("project_agent_waits")
}

model ProjectAgentContinuationCheckpoint {
  commandId   String   @id @db.VarChar(191)
  waitId      String   @unique
  runId       String
  status      String   @default("running") @db.VarChar(32)
  outcome     String?  @db.VarChar(32)
  messageId   String?  @db.VarChar(191)
  messageJson Json?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  wait        ProjectAgentWait @relation(fields: [waitId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
  @@map("project_agent_continuation_checkpoints")
}

model ProjectAgentRun {
  id             String    @id @default(uuid())
  projectId      String
  userId         String
  assistantId    String    @db.VarChar(64)
  scopeRef       String    @db.VarChar(64)
  episodeId      String?
  requestId      String    @db.VarChar(96)
  status         String    @default("running") @db.VarChar(32)
  runVersion     Int       @default(1)
  eventSeq       BigInt    @default(0)
  terminalEventSeq BigInt?
  controlKind    String    @db.VarChar(32)
  stopReason     String?   @db.VarChar(64)
  errorCode      String?   @db.VarChar(128)
  errorMessage   String?   @db.Text
  startedAt      DateTime  @default(now())
  heartbeatAt    DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  waits          ProjectAgentWait[]
  interruptions  ProjectAgentInterruption[]
  activities     ProjectAgentActivity[]
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId, assistantId, scopeRef, status, createdAt])
  @@index([projectId, status, createdAt])
  @@index([projectId, userId, assistantId, scopeRef, status, heartbeatAt], map: "project_agent_runs_scope_status_heartbeat_idx")
  @@index([requestId])
  @@map("project_agent_runs")
}

model ProjectAgentActivity {
  id                String    @id @default(uuid())
  runId             String
  projectId         String
  userId            String
  assistantId       String    @db.VarChar(64)
  scopeRef          String    @db.VarChar(64)
  episodeId         String?
  type              String    @db.VarChar(48)
  status            String    @default("running") @db.VarChar(32)
  operationId       String?   @db.VarChar(128)
  sourceOperationId String?   @db.VarChar(128)
  toolCallId        String?   @db.VarChar(128)
  choiceType        String?   @db.VarChar(64)
  errorCode         String?   @db.VarChar(128)
  errorMessage      String?   @db.Text
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  run               ProjectAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  waits             ProjectAgentWait[]
  interruptions     ProjectAgentInterruption[]
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([runId, status, createdAt])
  @@index([projectId, userId, assistantId, scopeRef, status, createdAt])
  @@index([projectId, status, createdAt])
  @@index([operationId])
  @@map("project_agent_activities")
}

model ProjectAgentEvent {
  id             BigInt    @id @default(autoincrement())
  projectId      String
  userId         String
  assistantId    String    @db.VarChar(64)
  scopeRef       String    @db.VarChar(64)
  episodeId      String?
  runId          String?
  activityId     String?
  kind           String    @db.VarChar(64)
  idempotencyKey String?   @unique @db.VarChar(191)
  payload        Json
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId, assistantId, scopeRef, id])
  @@index([runId, id])
  @@index([activityId, id])
  @@map("project_agent_events")
}

model ProjectAgentInterruption {
  id          String    @id @default(uuid())
  runId       String?
  activityId  String?
  projectId   String
  userId      String
  assistantId String    @db.VarChar(64)
  scopeRef    String    @db.VarChar(64)
  episodeId   String?
  type        String    @db.VarChar(32)
  status      String    @default("pending") @db.VarChar(32)
  runVersion  Int       @default(0)
  eventSeq    BigInt    @default(0)
  operationId String    @db.VarChar(128)
  approvalId  String    @db.VarChar(128)
  toolCallId  String?   @db.VarChar(128)
  payload     Json
  runState    String?   @db.LongText
  response    Json?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  run         ProjectAgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  activity    ProjectAgentActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([runId, status, createdAt])
  @@index([activityId])
  @@index([projectId, userId, assistantId, scopeRef, status, createdAt])
  @@index([userId])
  @@map("project_agent_interruptions")
}

model ProjectAssistantToolSelection {
  id            String    @id @default(uuid())
  userId        String
  projectId     String?
  episodeId     String?
  assistantId   String
  scopeRef      String
  selectionJson Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assistantId, scopeRef])
  @@index([projectId, episodeId, updatedAt])
  @@index([userId, updatedAt])
  @@map("project_assistant_tool_selections")
}

model ProjectStoryboard {
  id                  String                @id @default(uuid())
  episodeId           String
  chapterId           String
  editScriptId        String?               @unique
  storyboardImageUrl  String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  panelCount          Int                   @default(9)
  storyboardTextJson  String?               @db.Text
  lastError           String?
  panels              ProjectPanel[]
  editScript          ProjectEditScript? @relation(fields: [editScriptId], references: [id], onDelete: Cascade)
  episode             ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  chapter             ProjectEditChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  supplementaryPanels SupplementaryPanel[]

  @@index([editScriptId])
  @@index([episodeId])
  @@index([chapterId])
  @@map("project_storyboards")
}

model SupplementaryPanel {
  id            String                   @id @default(uuid())
  storyboardId  String
  sourceType    String
  sourcePanelId String?
  description   String?                  @db.Text
  imagePrompt   String?                  @db.Text
  imageUrl      String?                  @db.Text
  imageMediaId  String?
  imageMedia    MediaObject?             @relation("SupplementaryPanelImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  characters    String?                  @db.Text
  location      String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt
  storyboard    ProjectStoryboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  @@index([storyboardId])
  @@index([imageMediaId])
  @@map("supplementary_panels")
}

model Project {
  id                 String                   @id @default(uuid())
  name               String
  description        String?                  @db.Text
  userId             String
  analysisModel      String?
  imageModel         String?
  videoModel         String?
  singleShotVideoModel String?
  sequenceVideoModel String?
  musicModel         String?
  soundEffectModel   String?
  videoRatio         String                   @default("9:16")
  globalAssetText    String?                  @db.LongText
  characterModel     String?
  locationModel      String?
  storyboardModel    String?
  editModel          String?
  videoResolution    String                   @default("720p")
  capabilityOverrides String?                 @db.LongText
  lastEpisodeId      String?
  imageResolution    String                   @default("2K")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt
  lastAccessedAt     DateTime?
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageCosts         UsageCost[]
  assistantThreads   ProjectAssistantThread[]
  agentRuns          ProjectAgentRun[]
  agentActivities    ProjectAgentActivity[]
  agentEvents        ProjectAgentEvent[]
  agentWaits         ProjectAgentWait[]
  agentInterruptions ProjectAgentInterruption[]
  assistantToolSelections ProjectAssistantToolSelection[]
  mutationBatches    MutationBatch[]
  episodes           ProjectEpisode[]
  editStylePreviews  ProjectEditStylePreview[]
  editScripts        ProjectEditScript[]
  editShotExecutionPlans ProjectEditShotExecutionPlan[]
  editAssetRequirements ProjectEditAssetRequirement[]
  characters         ProjectCharacter[]
  locations          ProjectLocation[]
  canvasLayouts      ProjectCanvasLayout[]
  videoGroups        ProjectVideoGroup[]

  @@index([userId])
  @@map("projects")
}

model ProjectCanvasLayout {
  id            String                    @id @default(uuid())
  projectId     String
  episodeId     String                    @unique
  schemaVersion Int                       @default(1)
  viewportX     Float                     @default(0)
  viewportY     Float                     @default(0)
  zoom          Float                     @default(1)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt
  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode       ProjectEpisode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  nodeLayouts   ProjectCanvasNodeLayout[]

  @@unique([projectId, episodeId])
  @@index([projectId])
  @@map("project_canvas_layouts")
}

model ProjectCanvasNodeLayout {
  id          String              @id @default(uuid())
  layoutId    String
  nodeKey     String
  nodeType    String
  targetType  String
  targetId    String
  x           Float
  y           Float
  width       Float
  height      Float
  zIndex      Int                 @default(0)
  locked      Boolean             @default(false)
  collapsed   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  layout      ProjectCanvasLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, nodeKey])
  @@index([layoutId])
  @@index([targetType, targetId])
  @@map("project_canvas_node_layouts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model UsageCost {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  apiType   String
  model     String
  action    String
  quantity  Int
  unit      String
  cost      Decimal  @db.Decimal(18, 6)
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiType])
  @@index([createdAt])
  @@index([projectId])
  @@index([userId])
  @@map("usage_costs")
}

model User {
  id            String          @id @default(uuid())
  name          String          @unique(map: "User_name_key")
  email         String?
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  accounts      Account[]
  projects      Project[]
  sessions      Session[]
  usageCosts    UsageCost[]
  balance       UserBalance?
  preferences   UserPreference?

  // 资产中心
  globalAssetFolders      GlobalAssetFolder[]
  globalCharacters        GlobalCharacter[]
  globalLocations         GlobalLocation[]
  tasks                   Task[]
  taskEvents              TaskEvent[]
  projectAssistantThreads ProjectAssistantThread[]
  projectAgentRuns        ProjectAgentRun[]
  projectAgentActivities  ProjectAgentActivity[]
  projectAgentEvents      ProjectAgentEvent[]
  projectAgentWaits       ProjectAgentWait[]
  projectAgentInterruptions ProjectAgentInterruption[]
  projectAssistantToolSelections ProjectAssistantToolSelection[]
  mutationBatches         MutationBatch[]
  inviteRedemptions       InviteRedemption[]

  @@map("user")
}

model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  assistantModel      String? // 用户配置的 Assistant 对话模型（nullable，必须配置后才能使用）
  analysisModel       String? // 用户配置的分析模型（nullable，必须配置后才能使用）
  characterModel      String? // 用户配置的角色图片模型
  locationModel       String? // 用户配置的场景图片模型
  storyboardModel     String? // 用户配置的分镜图片模型
  editModel           String? // 用户配置的修图模型
  videoModel          String? // 用户配置的视频模型
  musicModel          String? // 用户配置的音乐/配乐模型
  soundEffectModel    String? // 用户配置的音效模型
  analysisConcurrency Int? // 分析流程并发上限
  imageConcurrency    Int? // 图像流程并发上限
  videoConcurrency    Int? // 视频流程并发上限
  videoRatio          String   @default("9:16")
  videoResolution     String   @default("720p")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  imageResolution     String   @default("2K")
  capabilityDefaults  String?  @db.Text

  // API Key 配置（极简版）
  llmBaseUrl  String? @default("https://openrouter.ai/api/v1")
  llmApiKey   String? @db.Text // 加密存储
  falApiKey   String? @db.Text // FAL（图片+视频）
  googleAiKey String? @db.Text // Google AI（Gemini 图片）
  arkApiKey   String? @db.Text // 火山引擎（Seedream+Seedance）

  // 自定义模型列表 + 价格（JSON）
  customModels String? @db.Text

  // 自定义 OpenAI 兼容提供商列表（JSON，包含加密的 API Key）
  customProviders String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model VerificationToken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model UserBalance {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @default(0) @db.Decimal(18, 6)
  frozenAmount Decimal  @default(0) @db.Decimal(18, 6)
  totalSpent   Decimal  @default(0) @db.Decimal(18, 6)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_balances")
}

model InviteCode {
  id              String    @id @default(uuid())
  codeHash        String    @unique @db.VarChar(128)
  amount          Decimal   @db.Decimal(18, 6)
  maxRedemptions  Int?
  redeemedCount   Int       @default(0)
  expiresAt       DateTime?
  disabledAt      DateTime?
  description     String?   @db.Text
  createdBy       String?   @db.VarChar(128)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  redemptions     InviteRedemption[]

  @@index([expiresAt])
  @@index([disabledAt])
  @@map("invite_codes")
}

model InviteRedemption {
  id           String     @id @default(uuid())
  inviteCodeId String
  userId       String
  amount       Decimal    @db.Decimal(18, 6)
  createdAt    DateTime   @default(now())
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, userId])
  @@index([userId])
  @@map("invite_redemptions")
}

model BalanceFreeze {
  id             String    @id @default(uuid())
  userId         String
  amount         Decimal   @db.Decimal(18, 6)
  status         String    @default("pending")
  source         String?   @db.VarChar(64)
  taskId         String?
  requestId      String?
  idempotencyKey String?   @unique
  metadata       String?   @db.Text
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@map("balance_freezes")
}

model BalanceTransaction {
  id              String   @id @default(uuid())
  userId          String
  type            String
  amount          Decimal  @db.Decimal(18, 6)
  balanceAfter    Decimal  @db.Decimal(18, 6)
  description     String?  @db.Text
  relatedId       String?
  freezeId        String?
  operatorId      String?  @db.VarChar(64)
  externalOrderId String?  @db.VarChar(128)
  idempotencyKey  String?  @db.VarChar(128)
  projectId       String?  @db.VarChar(128) // 关联项目 ID，用于流水展示项目名
  episodeId       String?  @db.VarChar(128) // 关联集数 ID，用于流水展示集数
  taskType        String?  @db.VarChar(64) // 任务类型 key（与 action 一致），用于前端 i18n
  billingMeta     String?  @db.Text // 计费详情 JSON: { quantity, unit, model, resolution, duration, tokens... }
  createdAt       DateTime @default(now())

  @@unique([userId, type, idempotencyKey])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([freezeId])
  @@index([externalOrderId])
  @@index([projectId])
  @@map("balance_transactions")
}

model Task {
  id               String    @id @default(uuid())
  userId           String
  projectId        String
  parentTaskId     String?
  episodeId        String?
  type             String
  targetType       String
  targetId         String
  status           String    @default("queued")
  progress         Int       @default(0)
  attempt          Int       @default(0)
  priority         Int       @default(0)
  dedupeKey        String?   @unique
  batchKey         String?
  externalId       String?
  operationId          String?   @db.VarChar(128)
  operationSource      String?   @db.VarChar(64)
  operationRequestId   String?   @db.VarChar(128)
  approvalGrantId      String?   @db.VarChar(191)
  operationExecutionId String?   @db.VarChar(191)
  operationPlanTaskId  String?   @db.VarChar(191)
  payload          Json?
  executionFingerprint String? @db.VarChar(64)
  result           Json?
  errorCode        String?
  errorMessage     String?   @db.Text
  billingInfo      Json?
  billedAt         DateTime?
  queuedAt         DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  heartbeatAt      DateTime?
  enqueuedAt       DateTime?
  enqueueAttempts  Int       @default(0)
  lastEnqueueError String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentTask Task?       @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks Task[]      @relation("TaskChildren")
  events     TaskEvent[]
  executionCheckpoints TaskExecutionCheckpoint[]
  approvalGrant ApprovalGrant? @relation(fields: [approvalGrantId], references: [id], onDelete: Restrict)
  operationExecution OperationExecution? @relation(fields: [operationExecutionId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([type])
  @@index([targetType, targetId])
  @@index([projectId])
  @@index([batchKey])
  @@index([parentTaskId])
  @@index([projectId, status, updatedAt])
  @@index([projectId, operationId, updatedAt])
  @@index([approvalGrantId])
  @@index([operationExecutionId])
  @@unique([operationExecutionId, operationPlanTaskId])
  @@index([userId])
  @@index([heartbeatAt])
  @@map("tasks")
}

model OperationPlanSnapshot {
  id              String   @id @default(uuid())
  contractVersion Int      @default(1)
  userId          String
  scopeKind       String   @db.VarChar(32)
  scopeId         String   @db.VarChar(191)
  projectId       String?
  episodeId       String?
  operationId     String   @db.VarChar(128)
  normalizedInput Json
  inputHash       String   @db.VarChar(64)
  planSnapshot    Json
  planHash        String   @db.VarChar(64)
  quoteSnapshot   Json
  quoteHash       String   @db.VarChar(64)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  approvalGrants  ApprovalGrant[]
  executions      OperationExecution[]

  @@index([userId, scopeKind, scopeId, operationId, createdAt])
  @@index([expiresAt])
  @@map("operation_plan_snapshots")
}

model ApprovalGrant {
  id                  String   @id @default(uuid())
  contractVersion     Int      @default(1)
  userId              String
  scopeKind           String   @db.VarChar(32)
  scopeId             String   @db.VarChar(191)
  projectId           String?
  episodeId           String?
  operationId         String   @db.VarChar(128)
  planSnapshotId      String
  requestId           String   @db.VarChar(128)
  inputHash           String   @db.VarChar(64)
  planHash            String   @db.VarChar(64)
  quoteHash           String   @db.VarChar(64)
  quoteCeiling        Decimal? @db.Decimal(18, 6)
  currency            String?  @db.VarChar(16)
  issuedAt            DateTime @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  consumedAt          DateTime?
  consumedExecutionId String?  @db.VarChar(191)
  version             Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  planSnapshot        OperationPlanSnapshot @relation(fields: [planSnapshotId], references: [id], onDelete: Restrict)
  executions          OperationExecution[]
  tasks               Task[]

  @@unique([planSnapshotId])
  @@index([userId, scopeKind, scopeId, operationId])
  @@index([consumedExecutionId])
  @@index([expiresAt])
  @@map("approval_grants")
}

model OperationExecution {
  id              String   @id @default(uuid())
  contractVersion Int      @default(1)
  userId          String
  scopeKind       String   @db.VarChar(32)
  scopeId         String   @db.VarChar(191)
  projectId       String?
  episodeId       String?
  operationId     String   @db.VarChar(128)
  planSnapshotId  String
  approvalGrantId String
  requestId       String   @db.VarChar(128)
  status          String   @db.VarChar(32)
  output          Json?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  planSnapshot    OperationPlanSnapshot @relation(fields: [planSnapshotId], references: [id], onDelete: Restrict)
  approvalGrant   ApprovalGrant @relation(fields: [approvalGrantId], references: [id], onDelete: Restrict)
  tasks           Task[]

  @@unique([approvalGrantId])
  @@unique([planSnapshotId, requestId])
  @@index([userId, scopeKind, scopeId, operationId, createdAt])
  @@index([status, updatedAt])
  @@map("operation_executions")
}

model TaskExecutionCheckpoint {
  id               String   @id @default(uuid())
  taskId           String
  stepKey          String   @db.VarChar(128)
  inputFingerprint String   @db.VarChar(64)
  state            String   @db.VarChar(32)
  output           Json
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepKey])
  @@index([taskId, state])
  @@map("task_execution_checkpoints")
}

model TaskEvent {
  id             Int      @id @default(autoincrement())
  taskId         String
  projectId      String
  userId         String
  eventType      String
  idempotencyKey String?  @unique @db.VarChar(191)
  payload        Json?
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, id])
  @@index([taskId])
  @@index([userId])
  @@map("task_events")
}

model OutboxCommand {
  id             String    @id @default(uuid())
  kind           String    @db.VarChar(64)
  version        Int       @default(1)
  idempotencyKey String    @unique @db.VarChar(191)
  aggregateType  String    @db.VarChar(64)
  aggregateId    String    @db.VarChar(96)
  payload        Json
  availableAt    DateTime  @default(now())
  enqueuedAt     DateTime?
  acceptedAt     DateTime?
  deadAt         DateTime?
  deliveryCount  Int       @default(0)
  leaseOwner     String?   @db.VarChar(96)
  leaseExpiresAt DateTime?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([acceptedAt, deadAt, availableAt])
  @@index([leaseExpiresAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_commands")
}

// ==================== 资产中心 ====================

// 资产文件夹（一层，不支持嵌套）
model GlobalAssetFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters GlobalCharacter[]
  locations  GlobalLocation[]

  @@index([userId])
  @@map("global_asset_folders")
}

// 全局角色（结构与 ProjectCharacter 一致）
model GlobalCharacter {
  id                 String       @id @default(uuid())
  userId             String
  folderId           String?
  name               String
  aliases            String?      @db.Text
  profileData        String?      @db.Text
  profileConfirmed   Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      GlobalAssetFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  appearances GlobalCharacterAppearance[]

  @@index([userId])
  @@index([folderId])
  @@map("global_characters")
}

// 全局角色形象（结构与 CharacterAppearance 一致）
model GlobalCharacterAppearance {
  id                   String       @id @default(uuid())
  characterId          String
  appearanceIndex      Int
  changeReason         String       @default("default")
  description          String?      @db.Text
  descriptions         String?      @db.Text
  imageUrl             String?      @db.Text
  imageMediaId         String?
  imageMedia           MediaObject? @relation("GlobalCharacterAppearanceImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  imageUrls            String?      @db.Text
  selectedIndex        Int?
  previousImageUrl     String?      @db.Text
  previousImageMediaId String?
  previousImageMedia   MediaObject? @relation("GlobalCharacterAppearancePreviousImageMedia", fields: [previousImageMediaId], references: [id], onDelete: SetNull)
  previousImageUrls    String?      @db.Text
  previousDescription  String?      @db.Text // 上一次的描述词（用于撤回）
  previousDescriptions String?      @db.Text // 上一次的描述词数组（用于撤回）
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  character GlobalCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, appearanceIndex])
  @@index([characterId])
  @@index([imageMediaId])
  @@index([previousImageMediaId])
  @@map("global_character_appearances")
}

// 全局场景（结构与 ProjectLocation 一致）
model GlobalLocation {
  id        String   @id @default(uuid())
  userId    String
  folderId  String?
  name      String
  summary   String?  @db.Text
  assetKind String   @default("location")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder GlobalAssetFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  images GlobalLocationImage[]

  @@index([userId])
  @@index([folderId])
  @@map("global_locations")
}

// 全局场景图片（结构与 LocationImage 一致）
model GlobalLocationImage {
  id                   String       @id @default(uuid())
  locationId           String
  imageIndex           Int
  description          String?      @db.Text
  imageUrl             String?      @db.Text
  spatialProfileJson   Json?
  spatialProfileStatus String       @default("pending")
  spatialProfileError  String?      @db.LongText
  spatialProfileAnalyzedAt DateTime?
  spatialProfileModel  String?
  imageMediaId         String?
  imageMedia           MediaObject? @relation("GlobalLocationImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  isSelected           Boolean      @default(false)
  previousImageUrl     String?      @db.Text
  previousImageMediaId String?
  previousImageMedia   MediaObject? @relation("GlobalLocationImagePreviousImageMedia", fields: [previousImageMediaId], references: [id], onDelete: SetNull)
  previousDescription  String?      @db.Text // 上一次的描述词（用于撤回）
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  location GlobalLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, imageIndex])
  @@index([locationId])
  @@index([imageMediaId])
  @@index([previousImageMediaId])
  @@map("global_location_images")
}

model MediaObject {
  id         String   @id @default(uuid())
  publicId   String   @unique
  storageKey String   @unique @db.VarChar(512)
  sha256     String?
  mimeType   String?
  sizeBytes  BigInt?
  width      Int?
  height     Int?
  durationMs Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  characterAppearanceImages             CharacterAppearance[]       @relation("CharacterAppearanceImageMedia")
  locationImages                        LocationImage[]             @relation("LocationImageMedia")
  projectEpisodeAudios           ProjectEpisode[]     @relation("ProjectEpisodeAudioMedia")
  projectEpisodeSourceDocumentRawFiles ProjectEpisodeSourceDocument[] @relation("ProjectEpisodeSourceDocumentRawFileMedia")
  projectPanelImages             ProjectPanel[]       @relation("ProjectPanelImageMedia")
  projectPanelVideos             ProjectPanel[]       @relation("ProjectPanelVideoMedia")
  projectEditChapterOutputVideos ProjectEditChapter[] @relation("ProjectEditChapterOutputMedia")
  projectVideoGroupReferenceImages ProjectVideoGroup[] @relation("ProjectVideoGroupReferenceImageMedia")
  projectVideoGroupVideos          ProjectVideoGroup[] @relation("ProjectVideoGroupVideoMedia")
  supplementaryPanelImages              SupplementaryPanel[]        @relation("SupplementaryPanelImageMedia")
  projectEpisodeFinalOutputVideos        ProjectEpisodeFinalOutput[] @relation("ProjectEpisodeFinalOutputMedia")
  globalCharacterAppearanceImages       GlobalCharacterAppearance[] @relation("GlobalCharacterAppearanceImageMedia")
  globalCharacterAppearancePreviousImgs GlobalCharacterAppearance[] @relation("GlobalCharacterAppearancePreviousImageMedia")
  globalLocationImageImages             GlobalLocationImage[]       @relation("GlobalLocationImageMedia")
  globalLocationImagePreviousImages     GlobalLocationImage[]       @relation("GlobalLocationImagePreviousImageMedia")
  @@index([createdAt])
  @@map("media_objects")
}

model LegacyMediaRefBackup {
  id          String   @id @default(uuid())
  runId       String
  tableName   String
  rowId       String
  fieldName   String
  legacyValue String   @db.Text
  checksum    String
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([tableName, fieldName])
  @@map("legacy_media_refs_backup")
}
