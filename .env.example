# ==================== 数据库 ====================
# 本地开发模式：docker-compose.yml 将 MySQL 映射到宿主机的 13306 端口
# Docker 容器模式：docker-compose.yml 会自动覆盖此配置
# 填写完整的 mysql:// 连接串；用户名和密码中的特殊字符需要 URL 编码。
DATABASE_URL=
# Docker Compose 内部连接必须使用 mysql 服务名而非 localhost。
COMPOSE_DATABASE_URL=
MYSQL_DATABASE=waoowaoo
MYSQL_USER=waoowaoo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
INFRA_BIND_ADDRESS=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1

# ==================== 存储 ====================
# minio: S3 兼容对象存储（默认）
# local: 本地文件存储（仅开发调试）
# cos: 预留 provider（当前版本未实现）
STORAGE_TYPE=minio

# MinIO / S3 兼容存储配置
# 本地开发模式：docker-compose.yml 将 MinIO 映射到宿主机的 19000 端口
MINIO_ENDPOINT=http://localhost:19000
MINIO_REGION=us-east-1
MINIO_BUCKET=waoowaoo
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_FORCE_PATH_STYLE=true

# COS 配置（预留）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# ==================== 认证 ====================
# 本地开发模式（方式三）：使用 http://localhost:3000
# Docker 容器模式（方式一、二）：由 docker-compose.yml 注入为 http://localhost:13000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=please-change-this-to-a-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==================== 应用内部自调用地址 ====================
# 仅用于服务端内部 fetch 本应用 API / 文件。
# 本地开发模式通常与 NEXTAUTH_URL 一致；Docker 模式由 docker-compose.yml 注入为 http://127.0.0.1:3000
INTERNAL_APP_URL=http://127.0.0.1:3000

# ==================== 内部密钥 ====================
CRON_SECRET=please-change-this-cron-secret
API_ENCRYPTION_KEY=

# ==================== Redis ====================
# 本地开发模式：docker-compose.yml 将 Redis 映射到宿主机的 16379 端口
# Docker 容器模式：docker-compose.yml 会自动覆盖此配置
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=

# 仅当应用位于已知数量的可信反向代理之后时设置为正整数；直连保持 0。
TRUSTED_PROXY_HOPS=0

# 默认禁止 Provider 请求访问私网。仅为明确受信任的自托管 Provider 填写精确主机名/IP，逗号分隔。
PROVIDER_OUTBOUND_PRIVATE_HOST_ALLOWLIST=

# ==================== Worker 配置 ====================
TASK_RECONCILE_INTERVAL_MS=60000
TASK_PROCESSING_TIMEOUT_MS=300000
TASK_RECONCILE_TERMINAL_GRACE_MS=90000
TASK_RECONCILE_MISSING_GRACE_MS=30000
OUTBOX_DISPATCH_INTERVAL_MS=5000
OUTBOX_STALE_ENQUEUED_MS=90000
OUTBOX_LEASE_MS=900000
OUTBOX_MAX_DELIVERY_ATTEMPTS=5
QUEUE_CONCURRENCY_IMAGE=50
QUEUE_CONCURRENCY_VIDEO=50
QUEUE_CONCURRENCY_MUSIC=50
QUEUE_CONCURRENCY_VOICE=50
QUEUE_CONCURRENCY_TEXT=50
QUEUE_CONCURRENCY_OUTBOX=10
WORKER_EXTERNAL_TIMEOUT_MS=1200000
WORKER_EXTERNAL_POLL_MS=3000

# 单用户默认工作流并发；DB 中的用户显式配置优先于这些默认值
DEFAULT_WORKFLOW_CONCURRENCY_ANALYSIS=5
DEFAULT_WORKFLOW_CONCURRENCY_IMAGE=20
DEFAULT_WORKFLOW_CONCURRENCY_VIDEO=10

# ==================== Bull Board (任务管理面板) ====================
BULL_BOARD_HOST=127.0.0.1
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# 如需从局域网调试 Next.js，显式填写精确来源，逗号分隔；禁止通配网段。
NEXT_ALLOWED_DEV_ORIGINS=

# ==================== 日志 ====================
LOG_UNIFIED_ENABLED=true
LOG_LEVEL=ERROR
LOG_FORMAT=json
LOG_DEBUG_ENABLED=false
LOG_AUDIT_ENABLED=true
LOG_SERVICE=waoowaoo
LOG_REDACT_KEYS=password,token,apiKey,apikey,authorization,cookie,secret,access_token,refresh_token

# ==================== 计费 ====================
DEPLOYMENT_EDITION=self-hosted
PROVIDER_CREDENTIAL_MODE=user-key
BILLING_MODE=OFF

# 官方 cloud 内测模式使用：
# 本地调试请复制 .env.cloud.example 到 .env.cloud.local，然后运行 npm run dev:cloud。
# DEPLOYMENT_EDITION=cloud
# PROVIDER_CREDENTIAL_MODE=platform-key
# BILLING_MODE=ENFORCE
# ADMIN_CREDIT_TOKEN=
# ADMIN_USER_IDS=
# PLATFORM_GOOGLE_API_KEY=
# PLATFORM_FAL_API_KEY=
# PLATFORM_ARK_API_KEY=
# PLATFORM_OPENROUTER_API_KEY=
# PLATFORM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PLATFORM_DEFAULT_ASSISTANT_MODEL=openrouter::openai/gpt-5.5
# PLATFORM_DEFAULT_ANALYSIS_MODEL=openrouter::anthropic/claude-sonnet-4.6
# PLATFORM_DEFAULT_ASSISTANT_REASONING_EFFORT=high
# PLATFORM_DEFAULT_ANALYSIS_REASONING_EFFORT=high
# PLATFORM_DEFAULT_CHARACTER_MODEL=fal::gpt-image-2
# PLATFORM_DEFAULT_LOCATION_MODEL=fal::gpt-image-2
# PLATFORM_DEFAULT_EDIT_MODEL=fal::gpt-image-2
# PLATFORM_DEFAULT_VIDEO_MODEL=openrouter::bytedance/seedance-2.0-fast
# PLATFORM_DEFAULT_MUSIC_MODEL=fal::fal-ai/lyria3/pro
# PLATFORM_IMAGE_RESOLUTION=
# PLATFORM_IMAGE_QUALITY=
# PLATFORM_VIDEO_RESOLUTION=720p
# PLATFORM_VIDEO_GENERATE_AUDIO=false
# PLATFORM_MUSIC_DURATION_SECONDS=
# PLATFORM_MUSIC_OUTPUT_FORMAT=

# 官方 cloud 公开页面内容目录（私有内容，不提交到 Git）
# 本地可用 .official-content；Docker/生产建议用只读 volume 挂载。
# OFFICIAL_CONTENT_DIR=.official-content

# 官方 cloud 真实充值（Stripe）
# 1 额度按人民币 1 元支付；生产最小值需满足 Stripe 账号结算币种的最低金额。
# PAYMENT_MIN_CREDITS=4
# PAYMENT_MAX_CREDITS=10000
# PAYMENT_PUBLIC_BASE_URL=https://demo.example.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ==================== 流式输出 ====================
LLM_STREAM_EPHEMERAL_ENABLED=true
