# ==================== 数据库 ====================
# 远端开发数据库固定运行在 192.168.0.112:13306。
DATABASE_URL="mysql://root:waoowaoo123@192.168.0.112:13306/waoowaoo"

# ==================== 存储 ====================
# minio: S3 兼容对象存储（默认）
# local: 本地文件存储（仅开发调试）
# cos: 预留 provider（当前版本未实现）
STORAGE_TYPE=minio

# MinIO / S3 兼容存储配置
# 远端 MinIO API 固定运行在 192.168.0.112:19000。
MINIO_ENDPOINT=http://192.168.0.112:19000
MINIO_REGION=us-east-1
MINIO_BUCKET=waoowaoo
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_FORCE_PATH_STYLE=true

# COS 配置（预留）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# ==================== 认证 ====================
# 宿主机开发服务地址。
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=please-change-this-to-a-random-string

# ==================== 应用内部自调用地址 ====================
# 服务端在宿主机上自调用本应用 API / 文件。
INTERNAL_APP_URL=http://127.0.0.1:3000

# ==================== 内部密钥 ====================
CRON_SECRET=please-change-this-cron-secret
INTERNAL_TASK_TOKEN=please-change-this-task-token
API_ENCRYPTION_KEY=waoowaoo-opensource-fixed-key-2026

# ==================== Redis ====================
# 远端 Redis 固定运行在 192.168.0.112:16379。
REDIS_HOST=192.168.0.112
REDIS_PORT=16379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=

# ==================== Worker 配置 ====================
WATCHDOG_INTERVAL_MS=30000
TASK_HEARTBEAT_TIMEOUT_MS=90000
CODEX_LLM_TIMEOUT_MS=1200000
QUEUE_CONCURRENCY_IMAGE=10
IMAGE_QUEUE_GLOBAL_CONCURRENCY=10
QUEUE_CONCURRENCY_VIDEO=1
QUEUE_CONCURRENCY_VOICE=20
QUEUE_CONCURRENCY_TEXT=50

# 本地媒体处理工具。两项都在当前进程 PATH 中时可留空；修改后需重启 Worker。
# macOS Apple Silicon: /opt/homebrew/bin/ffmpeg 与 /opt/homebrew/bin/ffprobe
# macOS Intel: /usr/local/bin/ffmpeg 与 /usr/local/bin/ffprobe
# Windows 原生 Node: C:\ffmpeg\bin\ffmpeg.exe 与 C:\ffmpeg\bin\ffprobe.exe
# WSL2 Ubuntu: /usr/bin/ffmpeg 与 /usr/bin/ffprobe（不要指向 Windows 的 .exe）
FFMPEG_PATH=
FFPROBE_PATH=

# ==================== Bull Board (任务管理面板) ====================
BULL_BOARD_HOST=0.0.0.0
BULL_BOARD_PORT=3010
BULL_BOARD_BASE_PATH=/admin/queues
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ==================== 日志 ====================
LOG_UNIFIED_ENABLED=true
LOG_LEVEL=ERROR
LOG_FORMAT=json
LOG_DEBUG_ENABLED=false
LOG_AUDIT_ENABLED=true
LOG_SERVICE=waoowaoo
LOG_REDACT_KEYS=password,token,apiKey,apikey,authorization,cookie,secret,access_token,refresh_token

# ==================== 计费 ====================
BILLING_MODE=OFF

# ==================== 流式输出 ====================
LLM_STREAM_EPHEMERAL_ENABLED=true

# ==================== ComfyUI 工作流 ====================
# ComfyUI 服务地址在应用设置中心配置为 http://192.168.0.112:8878。
# 可选：如果你希望继续使用仓库外的本地工作流目录，可在这里指定绝对路径。
# 留空时会优先使用仓库内置的 src/lib/providers/comfyui/workflows。
# COMFYUI_WORKFLOW_ROOT=D:\workspace\comfui\workflows
