# Local official cloud debugging template.
# Copy to .env.cloud.local and fill the private values locally.
# .env.cloud.local is ignored by git and Docker.
# npm run dev:cloud loads .env first, then overlays .env.cloud.local.

# ==================== Deployment ====================
DEPLOYMENT_EDITION=cloud
PROVIDER_CREDENTIAL_MODE=platform-key
BILLING_MODE=ENFORCE
NEXTAUTH_URL=http://localhost:3000
INTERNAL_APP_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
CRON_SECRET=
API_ENCRYPTION_KEY=
# Optional local administrative access. Development startup does not require it.
ADMIN_USER_IDS=
ADMIN_CREDIT_TOKEN=
# Direct local development has no trusted reverse proxy.
TRUSTED_PROXY_HOPS=0
OFFICIAL_CONTENT_DIR=.official-content
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BULL_BOARD_HOST=127.0.0.1
# Optional while Bull Board stays on loopback. Configure both values together.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ==================== Platform provider keys ====================
PLATFORM_GOOGLE_API_KEY=
PLATFORM_FAL_API_KEY=
PLATFORM_ARK_API_KEY=
PLATFORM_OPENROUTER_API_KEY=
PLATFORM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PLATFORM_ELEVENLABS_API_KEY=

# Main Agent and Creative Direction Worker share OpenAI hosted Web Search.
OPENAI_API_KEY=

# Cloud defaults should match the official production surface.
PLATFORM_DEFAULT_ASSISTANT_MODEL=openrouter::openai/gpt-5.5
PLATFORM_DEFAULT_ANALYSIS_MODEL=openrouter::anthropic/claude-sonnet-4.6
# Short mechanical LLM work (conversation summarisation). Cheapest LLM in the catalogue.
PLATFORM_DEFAULT_UTILITY_MODEL=openrouter::openai/gpt-5.6-luna
PLATFORM_DEFAULT_ASSISTANT_REASONING_EFFORT=high
PLATFORM_DEFAULT_ANALYSIS_REASONING_EFFORT=high
PLATFORM_DEFAULT_CHARACTER_MODEL=fal::gpt-image-2
PLATFORM_DEFAULT_LOCATION_MODEL=fal::gpt-image-2
PLATFORM_DEFAULT_EDIT_MODEL=fal::gpt-image-2
PLATFORM_DEFAULT_VIDEO_MODEL=openrouter::bytedance/seedance-2.0-fast
PLATFORM_DEFAULT_MUSIC_MODEL=fal::fal-ai/lyria3/pro
PLATFORM_VIDEO_RESOLUTION=720p
PLATFORM_VIDEO_GENERATE_AUDIO=false

# ==================== Workflow concurrency ====================
# Per-user defaults. Explicit userPreference concurrency values still take precedence.
DEFAULT_WORKFLOW_CONCURRENCY_ANALYSIS=5
DEFAULT_WORKFLOW_CONCURRENCY_IMAGE=20
DEFAULT_WORKFLOW_CONCURRENCY_VIDEO=10

# ==================== Stripe recharge ====================
PAYMENT_MIN_CREDITS=4
PAYMENT_MAX_CREDITS=10000
PAYMENT_PUBLIC_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
