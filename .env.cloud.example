COMPOSE_PROJECT_NAME=waoowaoo

DATABASE_URL=
COMPOSE_DATABASE_URL=
MYSQL_DATABASE=waoowaoo
MYSQL_USER=waoowaoo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
INFRA_BIND_ADDRESS=127.0.0.1

S3_ENDPOINT=http://127.0.0.1:19000
S3_UPLOAD_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=waoowaoo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
INTERNAL_APP_URL=http://127.0.0.1:3000
CRON_SECRET=
API_ENCRYPTION_KEY=

REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_TLS=false

TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_NAMESPACE=waoowaoo
TEMPORAL_TASK_QUEUE=waoowaoo-runtime
TEMPORAL_TLS_ENABLED=false
TEMPORAL_WORKER_DEPLOYMENT_NAME=waoowaoo
TEMPORAL_MYSQL_USER=temporal
TEMPORAL_MYSQL_PASSWORD=
TEMPORAL_HOST_PORT=17233
TEMPORAL_UI_HOST_PORT=18080
TEMPORAL_NAMESPACE_RETENTION=30d

CODEX_RUNTIME_DRIVER=docker
CODEX_RUNTIME_IMAGE=waoowaoo-codex-runtime:development
CODEX_RUNTIME_NETWORK=waoowaoo_codex-runtime
DOCKER_SOCKET_PATH=/var/run/docker.sock

DEPLOYMENT_EDITION=self-hosted
PROVIDER_CREDENTIAL_MODE=user-key
BILLING_MODE=OFF
LLM_STREAM_EPHEMERAL_ENABLED=true
LOG_UNIFIED_ENABLED=true
LOG_LEVEL=INFO
LOG_DEBUG_ENABLED=false
LOG_AUDIT_ENABLED=true

CODEX_RUNTIME_HOST_ROOT=C:\work\workspace\waoowaoo\.runtime\codex-runtime
CODEX_RUNTIME_IDLE_TIMEOUT_MS=900000
CODEX_RUNTIME_DRIVER=local
CODEX_RUNTIME_WAO_BASE_URL=http://127.0.0.1:3000
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=127.0.0.1,localhost,::1

COMFYUI_BASE_URL=http://127.0.0.1:8878/
